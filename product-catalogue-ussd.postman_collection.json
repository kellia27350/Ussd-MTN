{
  "info": {
    "name": "Product Catalogue - USSD + recording tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "phone",
      "value": "+250780000000"
    },
    {
      "key": "sessionId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0 - REST sanity check",
      "item": [
        {
          "name": "List categories",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "categories"
              ]
            }
          }
        },
        {
          "name": "List products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "A - Full flow (run in order)",
      "item": [
        {
          "name": "1. Dial *140# (new session)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ussd",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ussd"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"requestId\": 1,\n  \"phoneNumber\": \"{{phone}}\",\n  \"serviceCode\": \"*140#\",\n  \"text\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "if (j.sessionId) pm.collectionVariables.set(\"sessionId\", j.sessionId);",
                  "console.log(j.message);",
                  "pm.test(\"Language prompt returned\", () => pm.expect(pm.response.json().message).to.include(\"1.\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Choose English",
